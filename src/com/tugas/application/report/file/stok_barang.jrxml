	<property name="ireport.y" value="0"/>
	<queryString language="SQL">
		<![CDATA[SELECT b.id_barang, b.nama_barang, IFNULL(SUM(bm.jumlah), 0) AS total_masuk, IFNULL(SUM(bk.jumlah), 0) AS total_keluar, (IFNULL(SUM(bm.jumlah), 0) - IFNULL(SUM(bk.jumlah), 0)) AS stok_akhir FROM barang AS b LEFT JOIN barang_masuk AS bm ON b.id_barang = bm.id_barang LEFT JOIN barang_keluar AS bk ON b.id_barang = bk.id_barang GROUP BY b.id_barang, b.nama_barang ORDER BY b.nama_barang;]]>
	</queryString>
	<field name="id_barang" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="nama_barang" class="java.lang.String">
